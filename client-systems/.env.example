# Client Systems (https://clients.sopmojo.com)
#
# Local: SQLite. Production: dedicated Supabase project (NOT Builder, NOT Neon).
# Ryan: see MIGRATION.md for dashboard clicks. Do not put real secrets in git.

# SQLite for local/dev (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Production (dedicated Client Systems Supabase — transaction + session pooler).
# DATABASE_URL="postgresql://prisma.[PROJECT_REF]:[PRISMA_ROLE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://prisma.[PROJECT_REF]:[PRISMA_ROLE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL=

# Dedicated project API values (Project Settings → API). Not Builder.
# Prisma uses DATABASE_URL; these record the project and stay unused by app code.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for the session cookie. Required in production.
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional: protect GET /api/cron/escalate
CRON_SECRET=

# Optional fallback Slack incoming webhook (workspace settings can override)
WORKSPACE_SLACK_WEBHOOK=

# Optional Client Systems Kit checkout. Empty or "#" keeps Get the $39 Kit as a placeholder.
# Product+Offer JSON-LD on /client-systems-kit is emitted only when this is a real URL.
NEXT_PUBLIC_KIT_CHECKOUT_URL=
