# Client Systems (https://clients.sopmojo.com)

# SQLite for local/dev (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# HMAC secret for the session cookie. Required in production.
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional: protect GET /api/cron/escalate
CRON_SECRET=

# Optional fallback Slack incoming webhook (workspace settings can override)
WORKSPACE_SLACK_WEBHOOK=
