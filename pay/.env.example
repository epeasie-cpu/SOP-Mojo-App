# Stripe test keys. Leave live keys empty until the dashboard mode is switched to live.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional live keys. Unused while the catalog mode is test (the default).
STRIPE_LIVE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Dashboard gate. Ryan types this at /admin.
ADMIN_ACCESS_CODE=
# ADMIN_EMAILS=ryan@sopmojo.com
# ADMIN_SESSION_SECRET=

# Credential email. Prefer Make. It must email only and must not create a Supabase user.
MAKE_CREDENTIALS_WEBHOOK_URL=
# MAKE_CREDENTIALS_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=SOP Mojo <onboarding@resend.dev>

# Shared Builder Supabase project. Same one Flowchart Studio uses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENTITLEMENT_WEBHOOK_SECRET=
# ENTITLEMENTS_WEBHOOK_URL=https://flowchart.sopmojo.com/api/webhooks/entitlements

# Existing Mojo Business Solutions LLC audience. Tag applied: checkout.
MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=7c2226f741

# Required https link for the Quality Control Starter Pack email.
# Also added to the Quality System Fit Check email when set. Hidden there when empty.
# The pack page does not show this URL. The form refuses to send when it is unset.
# QMS_STARTER_PACK_URL=

# Required https link for the 2027 SLP CPT kit email.
# The kit page does not show this URL. The form refuses to send when it is unset or not https.
# CPT_KIT_URL=

# Comma-separated emails that can request the CPT kit again on a preview.
# A match skips the one-send claim and adds the Mailchimp tag qa.
# The rate limit, honeypot, and CPT_KIT_URL check still apply. Other offers are unchanged.
# LEAD_QA_EMAILS=qa@sopmojo.com

# Extra https origin for the lead popup API, besides https://pay.sopmojo.com.
# The deployment's VERCEL_URL is allowed on its own. Do not list every preview here.
# PAY_ORIGIN=

# Public links. Leave this as the brand host. Do not set a *.vercel.app URL.
# NEXT_PUBLIC_PAY_ORIGIN=https://pay.sopmojo.com
