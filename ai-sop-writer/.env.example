# Environment for AI SOP Writer (https://writer.sopmojo.com)

# Optional: if either key is set, drafts use a language model.
# If neither is set, the deterministic template engine runs and the UI labels "template mode".
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini)
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional override (defaults to claude-3-5-haiku-latest)
ANTHROPIC_MODEL=

# Required to email the SOP for copy, download, and print.
# Leave actions show an error when this is missing or Resend rejects the send.
RESEND_API_KEY=
# Optional. Defaults to SOP Mojo Writer <onboarding@resend.dev> for local/dev.
# Production should set a verified domain address, for example:
# EMAIL_FROM=SOP Mojo <writer@sopmojo.com>
# EMAIL_FROM=

# Optional. When unset, the SOP email still sends; Mailchimp tagging is skipped.
# Key looks like <secret>-<dc>, for example abcd-us21. The suffix is the API datacenter.
# Audience defaults to the Mojo Business Solutions LLC list 7c2226f741.
# The submitted email is tagged writer. A Mailchimp error does not block the send.
MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=7c2226f741
