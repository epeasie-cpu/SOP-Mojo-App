# Environment for AI SOP Writer (https://writer.sopmojo.com)

# Optional: if either key is set, drafts use a language model.
# If neither is set, the deterministic template engine runs and the UI labels "template mode".
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini)
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional override (defaults to claude-3-5-haiku-latest)
ANTHROPIC_MODEL=

# Shared Builder Supabase project. Same values as flowchart-studio.
# Email/password sign-in for copy, download, and print. Not a second user store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. When unset, lead capture still unlocks; Mailchimp is skipped.
# Key looks like <secret>-<dc>, for example abcd-us21. The suffix is the API datacenter.
# Audience defaults to the Mojo Business Solutions LLC list 7c2226f741.
MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=7c2226f741
