# Environment for Flowchart Studio (https://flowchart.sopmojo.com)

# Vision + chat/generate. Never commit real keys.
# If neither is set, text/voice still work via the local template engine.
# Photo (handwriting) requires a vision-capable key.
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini; vision uses gpt-4o-mini)
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional override (defaults to claude-3-5-haiku-latest; vision uses claude-sonnet-4-5)
ANTHROPIC_MODEL=

# Freemium checkout CTAs (public). Builder Pro $39/mo is the primary unlock path.
# Flowchart+ / optional $19 SamCart Slide Checkout (defaults to flowchart-studio if unset).
NEXT_PUBLIC_FLOWCHART_CHECKOUT_URL=https://rpease1.mysamcart.com/checkout/flowchart-studio
NEXT_PUBLIC_BUILDER_CHECKOUT_URL=https://rpease1.mysamcart.com/checkout/sop-builder-pro

# Shared Builder Pro Supabase project. Sign-in and flowchart_maps upserts use the user JWT.
# RLS is user_id = auth.uid(). Studio does not use the service role.
# Migration lives in mojo-sop-builder: database/migrations/20260924_flowchart_library_and_placement.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override for the Builder origin used by /api/studio/* (defaults to https://builder.sopmojo.com).
# NEXT_PUBLIC_BUILDER_ORIGIN=https://builder.sopmojo.com
