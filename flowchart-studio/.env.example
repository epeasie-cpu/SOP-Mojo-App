# Environment for Flowchart Studio (https://flowchart.sopmojo.com)

# Vision + chat/generate. Never commit real keys.
# If neither is set, text/voice still work via the local template engine.
# Photo (handwriting) requires a vision-capable key.
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini; vision uses gpt-4o-mini)
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional override (defaults to claude-3-5-haiku-latest; vision uses claude-sonnet-4-5)
ANTHROPIC_MODEL=

# Freemium checkout CTAs (public). Builder Pro $39/mo is the primary unlock path.
# Flowchart+ / optional $19 SamCart Slide Checkout (defaults to flowchart-studio if unset).
NEXT_PUBLIC_FLOWCHART_CHECKOUT_URL=https://rpease1.mysamcart.com/checkout/flowchart-studio
NEXT_PUBLIC_BUILDER_CHECKOUT_URL=https://rpease1.mysamcart.com/checkout/sop-builder-pro

# Shared Builder Pro Supabase project. Sign-in and the map library use this account.
# NEXT_PUBLIC_* is enough for the browser sign-in. The service role lets Studio
# persist maps (see supabase/0001_flowchart_maps.sql). Without the service role,
# production library calls fail closed; local dev keeps an in-memory library.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override when proxying the Builder attach API (defaults to https://builder.sopmojo.com).
# BUILDER_ORIGIN=https://builder.sopmojo.com

# Allow Authorization: Bearer dev:<userId> outside local/test. Leave unset in production.
# FLOWCHART_AUTH_DEV=
