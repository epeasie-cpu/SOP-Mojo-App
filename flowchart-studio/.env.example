# Environment for Flowchart Studio (https://flowchart.sopmojo.com)

# Vision + chat/generate. Never commit real keys.
# If neither is set, text/voice still work via the local template engine.
# Photo (handwriting) requires a vision-capable key.
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini; vision uses gpt-4o-mini)
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional override (defaults to claude-3-5-haiku-latest; vision uses claude-sonnet-4-5)
ANTHROPIC_MODEL=

# Checkout CTAs (public).
# Flowchart Plus $19 one-time (print + export). Defaults to the flowchart-studio SamCart product.
# Builder Pro $39/mo also includes print + export, and is the only unlock for Export to Builder.
NEXT_PUBLIC_FLOWCHART_CHECKOUT_URL=https://rpease1.mysamcart.com/checkout/flowchart-studio
# Quote the value so the #samcart-slide-open-left hash is not treated as a comment.
NEXT_PUBLIC_BUILDER_CHECKOUT_URL="https://rpease1.mysamcart.com/checkout/builder-pro#samcart-slide-open-left"

# Shared Builder Pro Supabase project. Sign-in and flowchart_maps upserts use the user JWT.
# RLS is user_id = auth.uid(). Studio does not use the service role.
# Migration lives in mojo-sop-builder: database/migrations/20260924_flowchart_library_and_placement.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override for the Builder origin used by /api/studio/* (defaults to https://builder.sopmojo.com).
# NEXT_PUBLIC_BUILDER_ORIGIN=https://builder.sopmojo.com

# Server-only service role for the SAME Supabase project. The Make webhook uses it
# to match/create a user by email and upsert public.entitlements. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/webhooks/entitlements. Either name works.
# Make sends it as Authorization: Bearer <secret> (or x-webhook-secret).
ENTITLEMENT_WEBHOOK_SECRET=
# MAKE_WEBHOOK_SECRET=

# Ryan QA only. Off in production (unset or 0). When 1, the server honors ?unlock=
# on GET /api/entitlements and x-flowchart-qa-unlock on /api/studio/*. Not a client flag.
# ?unlock=1 or ?unlock=flowchart-plus → print + export only
# ?unlock=builder-pro → print, export, and Export to Builder
FLOWCHART_QA_UNLOCK=
